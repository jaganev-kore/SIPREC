# Node server. Keep localhost on a VM behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=3000

# Kore.ai Agent Assist SIPREC values from the Voice Gateway page.
KORE_SIPREC_PRIMARY_URI=sip:DO6L2vBf@savg-sbc1.kore.ai:5060?X-agentAssist=tru1
KORE_SIPREC_SECONDARY_URI=sip:DO6L2vBf@savg-sbc2.kore.ai:5060?X-agentAssist=tru1
KORE_SIPREC_IDENTIFIER=DO6L2vBf
KORE_SIP_TRANSPORT=TLS
KORE_DTMF=RFC2833

# GCE VM reserved external IPv4 address. The SIPREC SDP must advertise this address.
MEDIA_PUBLIC_IP=REPLACE_WITH_GCE_STATIC_EXTERNAL_IPV4
RTP_PORT=40000

# This prototype supports unencrypted RTP/AVP with PCMU/8000 only.
# Confirm the media profile with Kore before sending real call audio.
KORE_MEDIA_PROFILE=RTP/AVP

# Optional TLS trust/client identity files. Kore may require a client certificate.
KORE_TLS_CA_FILE=
KORE_TLS_CERT_FILE=
KORE_TLS_KEY_FILE=

# Leave blank until Kore provides a separate conversational voice-bot SIP URI.
KORE_VOICE_BOT_SIP_URI=
